# Copy to backend/.env and fill in.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=dev-only-change-me

# The browser-facing origin of the app (where users load the site).
# Dev: the Vite server. Prod: your real https origin.
# The OAuth redirect URI is PUBLIC_BASE_URL + /api/auth/google/callback
PUBLIC_BASE_URL=http://localhost:5173

# Set true in production (HTTPS only cookies). Leave false for http://localhost.
COOKIE_SECURE=false

DATABASE_URL=sqlite:///./app.db

# Optional: directory of the built frontend (frontend/dist) to serve from FastAPI.
# STATIC_DIR=../frontend/dist

# The NFL season the pool is playing.
SEASON=2026

# Download NFL data on a timer while the server runs. To load it by hand instead:
#   python -m app.ingest
REFRESH_ENABLED=true

# Comma-separated Google emails that become admins when they sign in.
ADMIN_EMAILS=

# Development only: freeze the app's clock (ISO time, UTC if no offset) to replay a past week.
# DEV_NOW=2026-09-17T20:00:00

# Nightly off-site backups to an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3).
# On when BACKUP_S3_BUCKET is set. The endpoint is the store's S3 API URL; leave blank for AWS.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_KEEP_DAYS=14
